DATAFLOW_DATABASE_URL=postgresql+psycopg://dataflow:dataflow_local@127.0.0.1:55432/dataflow
DATAFLOW_COOKIE_SECURE=false
DATAFLOW_SESSION_HOURS=12
DATAFLOW_REGISTRATION_ENABLED=true
DATAFLOW_STORAGE_PATH=.data/objects
DATAFLOW_MAX_UPLOAD_BYTES=5242880
DATAFLOW_MAX_OWNER_STORAGE_BYTES=1073741824
DATAFLOW_MAX_CSV_ROWS=100000
DATAFLOW_MAX_CSV_COLUMNS=128
DATAFLOW_PROCESSING_TIMEOUT_SECONDS=45
# Producción: dominio HTTPS exacto; COOKIE_SECURE=true. Sin comodines.
# Bases de datos (Fases 18B, 31 y 32): servidores permitidos (lista JSON; vacía = desactivado).
# DATAFLOW_POSTGRESQL_ALLOWED_HOSTS=["127.0.0.1"]
# DATAFLOW_SQLSERVER_ALLOWED_HOSTS=[]
# Modo público (sólo PostgreSQL): cualquier servidor con direcciones públicas. Necesita el
# servicio connector (Fase 32B) y su token, o reconocer que no está aislado (sólo desarrollo).
# DATAFLOW_DATABASE_PUBLIC_ACCESS=false
# DATAFLOW_CONNECTOR_URL=http://127.0.0.1:8100
# DATAFLOW_CONNECTOR_TOKEN=
# DATAFLOW_DATABASE_PUBLIC_UNISOLATED=false
# DATAFLOW_DATABASE_DENIED_HOSTS=[]
# DATAFLOW_DATABASE_EGRESS_IPS=[]
# DATAFLOW_DATABASE_MAX_BYTES=209715200
# Fase 33: copias en segundo plano (plazo e hilos por proceso de API).
# DATAFLOW_DATABASE_COPY_TIMEOUT_SECONDS=1800
# DATAFLOW_DATABASE_COPY_WORKERS=2
# DATAFLOW_DATABASE_MAX_CELL_BYTES=65536
# DATAFLOW_DATABASE_ATTEMPTS_PER_USER=10
# DATAFLOW_DATABASE_FAILURES_PER_DAY=30
# DATAFLOW_DATABASE_ATTEMPTS_PER_TARGET=20
DATAFLOW_ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:3002","http://127.0.0.1:3100"]
# Explicación automática con IA (C2, ADR-026/027): auto (por defecto: Anthropic si hay clave,
# si no desactivada) | disabled | fake (pruebas) | anthropic.
DATAFLOW_AI_PROVIDER=auto
DATAFLOW_AI_MODEL=claude-opus-5-5
DATAFLOW_AI_EFFORT=low
# La clave sólo en el .env local (ignorado por git) o como archivo de secreto; nunca aquí.
# DATAFLOW_AI_API_KEY=
# DATAFLOW_AI_API_KEY_FILE=/run/secrets/ai_api_key
DATAFLOW_AI_TIMEOUT_SECONDS=30
DATAFLOW_AI_MAX_OUTPUT_TOKENS=4000
DATAFLOW_AI_USER_DAILY_TOKENS=1000000
DATAFLOW_AI_PROJECT_MONTHLY_COST_USD=50
