DATAFLOW_DATABASE_URL=postgresql+psycopg://dataflow:dataflow_local@127.0.0.1:55432/dataflow
DATAFLOW_COOKIE_SECURE=false
DATAFLOW_SESSION_HOURS=12
DATAFLOW_REGISTRATION_ENABLED=true
DATAFLOW_STORAGE_PATH=.data/objects
DATAFLOW_MAX_UPLOAD_BYTES=5242880
DATAFLOW_MAX_OWNER_STORAGE_BYTES=104857600
DATAFLOW_MAX_CSV_ROWS=100000
DATAFLOW_MAX_CSV_COLUMNS=128
DATAFLOW_PROCESSING_TIMEOUT_SECONDS=45
# Producción: dominio HTTPS exacto; COOKIE_SECURE=true. Sin comodines.
DATAFLOW_ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:3002","http://127.0.0.1:3100"]
# Explicación automática con IA (C2, ADR-026): disabled (por defecto) | fake (pruebas) | anthropic.
DATAFLOW_AI_PROVIDER=disabled
DATAFLOW_AI_MODEL=claude-opus-5-5
DATAFLOW_AI_EFFORT=low
# La clave sólo en el .env local (ignorado por git) o como archivo de secreto; nunca aquí.
# DATAFLOW_AI_API_KEY=
# DATAFLOW_AI_API_KEY_FILE=/run/secrets/ai_api_key
DATAFLOW_AI_TIMEOUT_SECONDS=30
DATAFLOW_AI_MAX_OUTPUT_TOKENS=4000
DATAFLOW_AI_USER_DAILY_TOKENS=200000
DATAFLOW_AI_PROJECT_MONTHLY_COST_USD=5
